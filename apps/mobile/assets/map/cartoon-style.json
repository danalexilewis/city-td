{
  "version": 8,
  "name": "City TD Cartoon",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "© OpenStreetMap contributors © OpenFreeMap © OpenMapTiles"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#FFF8E7"
      }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "grass"],
      "paint": {
        "fill-color": "#6FBF73",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "wood"],
      "paint": {
        "fill-color": "#4E9A57",
        "fill-opacity": 0.65
      }
    },
    {
      "id": "landuse-park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": [
        "in",
        ["get", "class"],
        ["literal", ["park", "pitch", "cemetery", "garden"]]
      ],
      "paint": {
        "fill-color": "#7BC97F",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", ["get", "class"], "residential"],
      "paint": {
        "fill-color": "#FFE8A3",
        "fill-opacity": 0.45
      }
    },
    {
      "id": "landuse-commercial",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": [
        "in",
        ["get", "class"],
        ["literal", ["commercial", "retail", "industrial"]]
      ],
      "paint": {
        "fill-color": "#F6C79A",
        "fill-opacity": 0.4
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#4A90A4"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#4A90A4",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10,
          1.5,
          16,
          5
        ],
        "line-cap": "round",
        "line-join": "round"
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#E76F51",
        "fill-opacity": 0.55,
        "fill-outline-color": "#1F2A24"
      }
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["!=", ["get", "brunnel"], "tunnel"],
        [
          "in",
          ["get", "class"],
          [
            "literal",
            [
              "motorway",
              "trunk",
              "primary",
              "secondary",
              "tertiary",
              "minor",
              "service",
              "path",
              "track",
              "pedestrian"
            ]
          ]
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#1F2A24",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10,
          ["match", ["get", "class"], "motorway", 4, "trunk", 3.5, "primary", 3, 2],
          16,
          [
            "match",
            ["get", "class"],
            "motorway",
            16,
            "trunk",
            14,
            "primary",
            12,
            "secondary",
            11,
            "tertiary",
            10,
            "minor",
            9,
            7
          ]
        ]
      }
    },
    {
      "id": "road-fill",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["!=", ["get", "brunnel"], "tunnel"],
        [
          "in",
          ["get", "class"],
          [
            "literal",
            [
              "motorway",
              "trunk",
              "primary",
              "secondary",
              "tertiary",
              "minor",
              "service",
              "path",
              "track",
              "pedestrian"
            ]
          ]
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          ["get", "class"],
          "motorway",
          "#F4A261",
          "trunk",
          "#F4A261",
          "primary",
          "#F2D16B",
          "secondary",
          "#F2D16B",
          "tertiary",
          "#FFE8A3",
          "path",
          "#E9C46A",
          "pedestrian",
          "#E9C46A",
          "#FFF8E7"
        ],
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10,
          ["match", ["get", "class"], "motorway", 2.5, "trunk", 2, "primary", 1.8, 1],
          16,
          [
            "match",
            ["get", "class"],
            "motorway",
            12,
            "trunk",
            10,
            "primary",
            9,
            "secondary",
            8,
            "tertiary",
            7,
            "minor",
            6,
            4
          ]
        ]
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 14,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          14,
          12,
          18,
          18
        ],
        "text-max-angle": 30,
        "text-padding": 2
      },
      "paint": {
        "text-color": "#1F2A24",
        "text-halo-color": "#FFF8E7",
        "text-halo-width": 2
      }
    },
    {
      "id": "place-suburb",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": [
        "in",
        ["get", "class"],
        ["literal", ["suburb", "neighbourhood", "quarter"]]
      ],
      "minzoom": 11,
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": 14,
        "text-transform": "none",
        "text-anchor": "center"
      },
      "paint": {
        "text-color": "#1F2A24",
        "text-halo-color": "#FFE8A3",
        "text-halo-width": 2.5
      }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": [
        "in",
        ["get", "class"],
        ["literal", ["city", "town", "village"]]
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          8,
          14,
          14,
          28
        ],
        "text-anchor": "center",
        "text-padding": 4
      },
      "paint": {
        "text-color": "#1F2A24",
        "text-halo-color": "#FFF8E7",
        "text-halo-width": 3
      }
    }
  ]
}
